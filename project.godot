; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Blood Dragon Menu"
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://scripts/settings/SettingsManager.cs"
AudioManager="*res://scripts/audio/AudioManager.cs"
StatsOverlay="*res://scripts/ui/StatsOverlay.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=0
common/snap_controls_to_pixels=true

[dotnet]

project/assembly_name="BloodDragon"

[input_devices]

joypad/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method.linuxbsd="gl_compatibility"
